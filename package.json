{
  "name": "ember",
  "productName": "Ember",
  "version": "1.2.0",
  "description": "A personal planner: calendar, task board, Eisenhower matrix, routines and notes.",
  "author": {
    "name": "Thisuni Gunawardena"
  },
  "license": "UNLICENSED",
  "private": true,
  "main": "main.js",
  "homepage": "https://thixuni.github.io/ember/",
  "repository": {
    "type": "git",
    "url": "https://github.com/thixuni/ember.git"
  },
  "scripts": {
    "start": "electron .",
    "build:html": "node scripts/build-standalone.js",
    "test": "node --test",
    "check": "npm run build:html && npm test",
    "build": "npm run build:html && electron-builder",
    "build:win": "npm run build:html && electron-builder --win",
    "build:mac": "npm run build:html && electron-builder --mac",
    "build:linux": "npm run build:html && electron-builder --linux",
    "release": "node scripts/release.js",
    "icon": "electron scripts/make-icon.js"
  },
  "dependencies": {
    "electron-updater": "6.3.9"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.thisuni.ember",
    "productName": "Ember",
    "copyright": "Copyright © 2026 Thisuni Gunawardena",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "gcal.js",
      "google-client.json",
      "src/**/*",
      "build/icon.ico",
      "build/icon.png"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "thixuni",
        "repo": "ember"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Ember"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "dmg": {
      "title": "${productName} ${arch}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png",
      "category": "Office",
      "artifactName": "${productName}-${version}.${ext}"
    }
  }
}
